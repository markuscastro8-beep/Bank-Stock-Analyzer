# Copy to `.env` and fill in. python-dotenv loads this on startup.

# REQUIRED by the SEC: identify yourself in the User-Agent header.
# Format: "Application Name your.email@example.com"
SEC_USER_AGENT="BankStockAnalyzer/0.1 markuscastro8@gmail.com"

# Override defaults from config.yaml if you like:
# CACHE_DIR=./.cache
# OUTPUT_DIR=./output
# LOG_LEVEL=INFO

# OPTIONAL: only set this if you have a paid Seeking Alpha API subscription
# (e.g. via RapidAPI). The app falls back to public RSS only if unset.
# SEEKING_ALPHA_API_KEY=
